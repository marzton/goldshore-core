{
  "_comment": "Canonical Cloudflare resource IDs shared across all apps in this monorepo. Update these after provisioning and replace the placeholder strings in each app's wrangler.toml.",
  "d1": {
    "name": "gs-platform-prod",
    "id": "YOUR_D1_DATABASE_ID",
    "provision_cmd": "wrangler d1 create gs-platform-prod",
    "migrate_cmd": "wrangler d1 migrations apply gs-platform-prod --config apps/admin-dashboard/wrangler.toml"
  },
  "kv": {
    "name": "INFRA_SECRETS",
    "id": "YOUR_KV_NAMESPACE_ID",
    "provision_cmd": "wrangler kv:namespace create INFRA_SECRETS",
    "secrets": [
      "HUGGINGFACE_API_KEY",
      "ODDS_API_KEY",
      "DISCORD_BOT_TOKEN",
      "JWT_SECRET"
    ],
    "put_example": "wrangler kv:key put --namespace-id=YOUR_KV_NAMESPACE_ID HUGGINGFACE_API_KEY <value>"
  },
  "apps": [
    { "name": "banproof-me",     "path": "apps/banproof-me",     "type": "worker" },
    { "name": "goldshore-ai",    "path": "apps/goldshore-ai",    "type": "pages"  },
    { "name": "goldshore-admin", "path": "apps/admin-dashboard", "type": "worker" }
  ]
}
