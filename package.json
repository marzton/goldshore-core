{
  "name": "goldshore-core",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:banproof": "npm run dev --workspace=apps/banproof-me",
    "dev:goldshore-ai": "npm run dev --workspace=apps/goldshore-ai",
    "dev:admin": "npm run dev --workspace=apps/admin-dashboard",
    "deploy:banproof": "npm run deploy --workspace=apps/banproof-me",
    "deploy:goldshore-ai": "npm run deploy --workspace=apps/goldshore-ai",
    "deploy:admin": "npm run deploy --workspace=apps/admin-dashboard",
    "migrate": "wrangler d1 migrations apply gs-platform-prod"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.0"
  }
}
